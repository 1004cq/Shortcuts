PORT=3002
HOST=0.0.0.0
# Shared secret for Web control + Shortcuts join
AUTH_TOKEN=change-me-to-a-long-random-string
# Public URL shown in UI / Shortcuts (behind nginx)
PUBLIC_URL=https://cq.imim.chat/realtime
# Allow browser origins (comma-separated). Use * only for testing.
CORS_ORIGIN=https://cq.imim.chat
# Max audio URL length
MAX_AUDIO_URL_LENGTH=2048
