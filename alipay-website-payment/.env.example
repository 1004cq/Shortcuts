# ==============================
# 服务基础配置
# ==============================
PORT=4000

# 本服务对外可访问的根地址（本地调试请用内网穿透后的 HTTPS 域名）
# 用于拼接默认的 NOTIFY_URL / RETURN_URL
APP_URL=http://localhost:4000

# ==============================
# 支付宝开放平台密钥（切勿提交到 Git）
# ==============================

# 应用 APPID
APP_ID=

# 应用私钥（商户私钥）。多行可用 \n 写成一行，例如：
# -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
PRIVATE_KEY=

# 支付宝公钥（开放平台「支付宝公钥」，不是应用公钥）
ALIPAY_PUBLIC_KEY=

# 密钥格式：PKCS8（推荐）或 PKCS1
# 若密钥工具生成的是 PKCS8，保持 PKCS8；若是 RSA PRIVATE KEY 头则改 PKCS1
KEY_TYPE=PKCS8

# ==============================
# 沙箱 / 生产切换
# ==============================
#
# 方式一（推荐）：用 GATEWAY 直接指定网关
#   沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
#   生产：https://openapi.alipay.com/gateway.do
#
GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 方式二：也可用 ALIPAY_SANDBOX=true/false（当未设置 GATEWAY 时生效）
ALIPAY_SANDBOX=true

# ==============================
# 回调地址（必须公网可达；生产必须 HTTPS）
# ==============================
# 异步通知（支付宝服务器 POST）
NOTIFY_URL=http://localhost:4000/notify
# 同步跳转（用户浏览器 GET）
RETURN_URL=http://localhost:4000/return

# ==============================
# 演示商品（首页「立即支付」可改这里）
# ==============================
PRODUCT_TITLE=测试商品 - MediaVault 会员
PRODUCT_AMOUNT=0.01
PRODUCT_DESC=沙箱建议使用 0.01 元完成联调
