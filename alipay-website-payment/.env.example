# 服务
PORT=4000
APP_URL=http://localhost:4000

# 支付宝开放平台 https://open.alipay.com
ALIPAY_APP_ID=
# 应用私钥（PKCS8 推荐；多行可用 \n 写成一行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（开放平台「支付宝公钥」，不是应用公钥）
ALIPAY_PUBLIC_KEY=
# PKCS8 | PKCS1
ALIPAY_KEY_TYPE=PKCS8

# 可选：覆盖默认回调地址
# ALIPAY_NOTIFY_URL=http://localhost:4000/api/payment/notify
# ALIPAY_RETURN_URL=http://localhost:4000/api/payment/return

# 沙箱：true 时使用沙箱网关
ALIPAY_SANDBOX=false
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
