# ========== 服务 ==========
PORT=4000
# 公网可访问地址（异步通知必须能被支付宝访问；本地请用内网穿透）
APP_URL=http://localhost:4000

# ========== 支付宝密钥（切勿提交到 Git）==========
# 开放平台应用 APPID
ALIPAY_APP_ID=

# 应用私钥（商户私钥）。支持多行，或用 \n 写成一行
# 例：-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（开放平台「支付宝公钥」，不是应用公钥）
ALIPAY_PUBLIC_KEY=

# 密钥格式：PKCS8（密钥工具默认转 PKCS8）或 PKCS1
ALIPAY_KEY_TYPE=PKCS8

# ========== 沙箱 / 生产切换 ==========
# true  = 沙箱网关 https://openapi-sandbox.dl.alipaydev.com/gateway.do
# false = 生产网关 https://openapi.alipay.com/gateway.do
ALIPAY_SANDBOX=true

# 可选：强制指定网关（优先级高于 ALIPAY_SANDBOX）
# ALIPAY_GATEWAY=

# 可选：覆盖回调（默认使用 APP_URL + 路径）
# ALIPAY_NOTIFY_URL=https://your.domain/api/payment/notify
# ALIPAY_RETURN_URL=https://your.domain/api/payment/return
