# MediaVault environment variables
# Copy to .env.local for local development

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mediavault

# Local file storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2147483648

# Optional SMTP (leave empty to log verification links in console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediaVault <noreply@mediavault.local>
