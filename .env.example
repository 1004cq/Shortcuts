# MediaVault environment variables
# Copy to .env.local for local development

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mediavault

# Local file storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2147483648

# Optional SMTP (leave empty to log verification links in console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediaVault <noreply@mediavault.local>

# Alipay (电脑网站/手机网站支付)
# Create app at https://open.alipay.com — enable 电脑网站支付 + 手机网站支付
# Standalone Express demo (same keys): see ./alipay-website-payment/README.md
ALIPAY_APP_ID=
# Preferred on Linux/systemd: PEM file paths (avoids \n mangling in EnvironmentFile)
# ALIPAY_PRIVATE_KEY_PATH=/opt/mediavault/secrets/alipay_private.pem
# ALIPAY_PUBLIC_KEY_PATH=/opt/mediavault/secrets/alipay_public.pem
# Or inline (quote the value; use \n for newlines)
ALIPAY_PRIVATE_KEY=
# Alipay public key (开放平台「支付宝公钥」, not 应用公钥)
ALIPAY_PUBLIC_KEY=
# PKCS8 | PKCS1
ALIPAY_KEY_TYPE=PKCS8
# Optional overrides (defaults to APP_URL + paths below)
# ALIPAY_NOTIFY_URL=https://your.domain/api/payments/alipay/notify
# ALIPAY_RETURN_URL=https://your.domain/api/payments/alipay/return
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Sandbox: set true and use sandbox gateway / keys
ALIPAY_SANDBOX=false
# When Alipay keys are missing, allow instant demo VIP activation
PAYMENT_DEMO_MODE=true

# Remote audio push (Socket.io under /realtime; control UI is /admin/remote-play)
# See ./remote-audio-push/USAGE_ADMIN_ONLY.md
REMOTE_AUDIO_URL=https://cq.imim.chat/realtime
REMOTE_AUDIO_TOKEN=
# Optional: token embedded in iPhone Shortcuts links (defaults to REMOTE_AUDIO_TOKEN)
# REMOTE_AUDIO_RECEIVER_TOKEN=

# Shortlink /apl billing — VIP/admin API token for download redirect
# If unset, MediaVault uses the first admin user's apiToken automatically
# SHORTLINK_API_TOKEN=mv_xxxxxxxx
